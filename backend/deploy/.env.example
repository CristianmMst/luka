# Copia este archivo a `~/apps/luka/.env` en el servidor (junto a
# compose.yml) y llena cada valor. Solo van las obligatorias; el resto tiene
# default en src/luka/shared/settings.py y se sobrescribe con
# LUKA_<NOMBRE>. `.env` nunca se sube al repo.

# Contrasena de Postgres: `openssl rand -hex 32` (solo hex, va dentro de la URL).
POSTGRES_PASSWORD=

# Secreto de los JWT: `openssl rand -base64 48`.
LUKA_JWT_SECRET=

# Cliente OAuth web de luka-510204 (audiencia del id_token) y su secreto.
LUKA_GOOGLE_CLIENT_ID=918126641294-eldnsshsmu7vufdajkesk69qim7ft9ph.apps.googleusercontent.com
LUKA_GOOGLE_CLIENT_SECRET=

# Llave AES-256-GCM de los refresh tokens de Gmail: `openssl rand -base64 32`.
# Si se pierde, hay que reconectar Gmail de todos los usuarios.
LUKA_GMAIL_TOKEN_KEY=

# Imagen a correr. La escribe el workflow de despliegue (digest de GHCR).
LUKA_IMAGE=ghcr.io/cristianmmst/luka-backend:latest
