# Copia este archivo a `~/apps/finanzia/.env` en el servidor (junto a
# compose.yml) y llena cada valor. Solo van las obligatorias; el resto tiene
# default en src/finanzia/shared/settings.py y se sobrescribe con
# FINANZIA_<NOMBRE>. `.env` nunca se sube al repo.

# Contrasena de Postgres: `openssl rand -hex 32` (solo hex, va dentro de la URL).
POSTGRES_PASSWORD=

# Secreto de los JWT: `openssl rand -base64 48`.
FINANZIA_JWT_SECRET=

# Cliente OAuth web de finanzia-509500 (audiencia del id_token) y su secreto.
FINANZIA_GOOGLE_CLIENT_ID=30065910946-hatnfnvkk8782gf8qgbii9qdlqf61jn4.apps.googleusercontent.com
FINANZIA_GOOGLE_CLIENT_SECRET=

# Llave AES-256-GCM de los refresh tokens de Gmail: `openssl rand -base64 32`.
# Si se pierde, hay que reconectar Gmail de todos los usuarios.
FINANZIA_GMAIL_TOKEN_KEY=

# Imagen a correr. La escribe el workflow de despliegue (digest de GHCR).
FINANZIA_IMAGE=ghcr.io/cristianmmst/finanzia-backend:latest
