# Proxy de entrada (backend/deploy/README.md): HTTPS automatico con Let's
# Encrypt para {$DOMAIN}. Sin access log a proposito: la ruta cruda y el
# query pueden llevar datos del usuario (spec 009, P1); la API ya loguea la
# plantilla de la ruta.
{
	email {$ACME_EMAIL}
	servers {
		# La IP del cliente llega a la API en X-Forwarded-For.
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# La API corta en 1 MiB (FINANZIA_MAX_BODY_BYTES); esto frena antes lo
	# que sea mucho mas grande.
	request_body {
		max_size 2MB
	}

	reverse_proxy api:8000 {
		health_uri /health
		health_interval 30s
	}
}
