# Copia este archivo a backend/.env para desarrollo local.
# Solo van las variables obligatorias; el resto tiene valor por defecto en
# src/finanzia/shared/settings.py y se sobrescribe con FINANZIA_<NOMBRE> si hace falta.

# Postgres (driver asyncpg) y Redis de `just up`.
FINANZIA_DATABASE_URL=postgresql+asyncpg://finanzia:finanzia@localhost:5432/finanzia
FINANZIA_REDIS_URL=redis://localhost:6379/0

# Secreto para firmar JWT, minimo 32 caracteres (uno distinto por entorno real).
FINANZIA_JWT_SECRET=cambia-este-secreto-de-desarrollo-de-al-menos-32-chars

# Client ID web de Google Cloud (proyecto de desarrollo finanzia-509500): audiencia
# del id_token que envia la app. No es un secreto.
FINANZIA_GOOGLE_CLIENT_ID=30065910946-hatnfnvkk8782gf8qgbii9qdlqf61jn4.apps.googleusercontent.com

# Opcional: API key de DeepSeek para el parser LLM (sin ella, ese paso se omite).
# FINANZIA_DEEPSEEK_API_KEY=
