# Copia este archivo a backend/.env y ajusta los valores para desarrollo local.

# Entorno de ejecucion: dev, test o prod.
FINANZIA_ENV=dev

# URL de conexion asincrona a Postgres (driver asyncpg).
FINANZIA_DATABASE_URL=postgresql+asyncpg://finanzia:finanzia@localhost:5432/finanzia

# URL de conexion a Redis.
FINANZIA_REDIS_URL=redis://localhost:6379/0

# Secreto para firmar JWT, minimo 32 caracteres (usa uno distinto por entorno real).
FINANZIA_JWT_SECRET=cambia-este-secreto-de-desarrollo-de-al-menos-32-chars

# Tiempo de vida del access token, en segundos.
FINANZIA_JWT_ACCESS_TTL_SECONDS=900

# Tiempo de vida del refresh token, en dias.
FINANZIA_REFRESH_TTL_DAYS=60

# Client ID de Google OAuth usado para verificar tokens de login.
FINANZIA_GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Verificador de tokens de Google: "google" (real) o "fake" (solo dev/test).
FINANZIA_GOOGLE_VERIFIER=fake

# Nivel de logging: DEBUG, INFO, WARNING o ERROR.
FINANZIA_LOG_LEVEL=INFO

# Logs en formato JSON estructurado (por defecto es true salvo en dev).
FINANZIA_LOG_JSON=false

# Confiar en las cabeceras X-Forwarded-* enviadas por un proxy reverso.
FINANZIA_TRUST_PROXY_HEADERS=false

# Limite de requests por minuto para los endpoints de autenticacion.
FINANZIA_RATE_LIMIT_AUTH_PER_MINUTE=10

# Limite de requests por minuto por usuario autenticado.
FINANZIA_RATE_LIMIT_USER_PER_MINUTE=600

# Tiempo de vida, en segundos, de las claves de idempotencia.
FINANZIA_IDEMPOTENCY_TTL_SECONDS=86400

# Tamano maximo aceptado del body de una request, en bytes.
FINANZIA_MAX_BODY_BYTES=1048576

# Tamano del pool de conexiones a la base de datos.
FINANZIA_DB_POOL_SIZE=10

# Loguear las sentencias SQL ejecutadas (nunca debe ser true en prod).
FINANZIA_DB_ECHO=false

# Limite de requests por minuto para los endpoints de ingesta (F2.1).
FINANZIA_RATE_LIMIT_INGEST_PER_MINUTE=60

# API key de DeepSeek (LLM de parsing, F2.4). Sin valor, el LLM queda deshabilitado
# (legitimo tambien en prod: cae a revision manual con reason=llm_disabled).
FINANZIA_DEEPSEEK_API_KEY=

# URL base de la API de DeepSeek.
FINANZIA_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo de DeepSeek usado para el parseo por LLM.
FINANZIA_DEEPSEEK_MODEL=deepseek-v4-flash

# Timeout, en segundos, de las llamadas HTTP a DeepSeek.
FINANZIA_LLM_TIMEOUT_SECONDS=20.0

# Presupuesto mensual de tokens LLM por usuario.
FINANZIA_LLM_MONTHLY_TOKEN_BUDGET_PER_USER=200000

# Umbral minimo de confianza para aceptar una extraccion del LLM (0, 1].
FINANZIA_LLM_CONFIDENCE_THRESHOLD=0.8

# Dias de retencion del cuerpo de un mensaje crudo antes de purgarlo (>= 1).
FINANZIA_RAW_MESSAGE_RETENTION_DAYS=90

# Tamano maximo, en bytes, del cuerpo persistido de un mensaje crudo (>= 512).
FINANZIA_RAW_MESSAGE_BODY_MAX_BYTES=8192
