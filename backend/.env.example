# Copia este archivo a backend/.env para desarrollo local.
# Solo van las variables obligatorias; el resto tiene valor por defecto en
# src/luka/shared/settings.py y se sobrescribe con LUKA_<NOMBRE> si hace falta.

# Postgres (driver asyncpg) y Redis de `just up`.
LUKA_DATABASE_URL=postgresql+asyncpg://luka:luka@localhost:5432/luka
LUKA_REDIS_URL=redis://localhost:6379/0

# Secreto para firmar JWT, minimo 32 caracteres (uno distinto por entorno real).
LUKA_JWT_SECRET=cambia-este-secreto-de-desarrollo-de-al-menos-32-chars

# Proyecto GCP del entorno (desarrollo: luka-510204). Nada de esto es secreto,
# pero cambia con el proyecto, por eso no tiene default en el codigo.
# Cliente OAuth web (audiencia del id_token en Android y canje del serverAuthCode)
# y cliente OAuth iOS (audiencia del id_token en iOS).
LUKA_GOOGLE_CLIENT_ID=918126641294-eldnsshsmu7vufdajkesk69qim7ft9ph.apps.googleusercontent.com
LUKA_GOOGLE_IOS_CLIENT_ID=918126641294-67ug6b5u8fprmgj395em1mbu7jrrs5de.apps.googleusercontent.com
# Pub/Sub de Gmail: topic de users.watch, y audiencia y cuenta de servicio que se
# exigen al token OIDC del webhook (README §16).
LUKA_GMAIL_PUBSUB_TOPIC=projects/luka-510204/topics/gmail-push
LUKA_GMAIL_PUSH_AUDIENCE=luka-gmail-push
LUKA_GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push-invoker@luka-510204.iam.gserviceaccount.com

# Secreto del cliente OAuth web (canje de serverAuthCode de Gmail, Fase 3). Real
# solo en el entorno del servidor; cambialo por el tuyo de desarrollo.
LUKA_GOOGLE_CLIENT_SECRET=cambia-este-secreto-oauth-de-desarrollo

# Llave AES-256-GCM para cifrar refresh tokens de Gmail (spec 009 §3): 32 bytes
# aleatorios en base64, por ejemplo `openssl rand -base64 32`. Una distinta por
# entorno real; esta es solo de desarrollo.
LUKA_GMAIL_TOKEN_KEY=62aisewZDhTFPU8eKAYDMaVzeVR4usdqlWxZgK7Abbg=

# Opcional: API key de DeepSeek para el parser LLM (sin ella, ese paso se omite).
# LUKA_DEEPSEEK_API_KEY=
